{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/run",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/run?source=daily-digest",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "src/app/api/webhooks/booking-com/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/clerk/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/webhooks/stripe/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/cron/run/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/ical/[token]/route.ts": {
      "maxDuration": 15
    }
  }
}
