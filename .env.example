# ── Vercel deployment quickref ─────────────────────────────────────────────
#
# Required:
#   DATABASE_URL                               postgres://… (Neon, Supabase, RDS, …)
#
# Recommended:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY          enables auth + multi-tenant scoping
#   CLERK_SECRET_KEY                           must match Clerk app
#   CLERK_WEBHOOK_SECRET                       enables auto-provision on user.created
#   CRON_SECRET                                guards /api/cron/run (Vercel Cron sets Authorization: Bearer)
#   STAYBOARD_HOTEL_ID                         pin to a single hotel (skip Clerk lookup)
#
# Optional (per-feature):
#   STRIPE_SECRET_KEY + NEXT_PUBLIC_STRIPE_ENABLED + STRIPE_WEBHOOK_SECRET
#   HOSTAWAY_API_KEY + HOSTAWAY_ACCOUNT_ID
#   WEBHOOK_SECRET                             /api/webhooks/booking-com header check
#
# vercel.json ships with /api/cron/run on `*/30 * * * *` and per-route timeouts.
# After first deploy: configure the same env vars in Project Settings → Environment Variables,
# then re-deploy. Postgres migrations run via `npx prisma migrate deploy` in your build step
# (already in `npm run build` if you add `prisma generate && prisma migrate deploy &&` prefix).

DATABASE_URL="postgresql://stayboard:stayboard@localhost:5432/stayboard?schema=public"

# ── Optional: Clerk authentication ────────────────────────────────────────
# Setting BOTH keys enables Clerk; missing either, the app stays in
# open-dev mode (currentHotelId() falls back to the first seeded hotel).
#
# 1. Sign up at https://clerk.com (free tier is fine for dev).
# 2. Create an Application; copy the two keys below into .env.
# 3. After creating your first user, edit them in the Clerk dashboard:
#    Public metadata → { "hotelId": "<cuid of your hotel from `npm run db:studio`>" }
# 4. Restart `npm run dev`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Where Clerk routes go after sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Auto-provision Hotel on Clerk user signup:
#   1. Clerk Dashboard → Webhooks → Add Endpoint
#   2. URL: https://<your-host>/api/webhooks/clerk
#   3. Subscribe to event: user.created
#   4. Copy the Signing Secret (starts with `whsec_`) into the var below
# When set, every Clerk user.created fires our webhook, which:
#   - creates a new Hotel (named "{firstName}'s Hotel")
#   - seeds 1 room type + 1 room + 1 rate plan + 6 channels + 4 saved replies
#   - sets the user's publicMetadata.hotelId to the new hotel id
# After this, currentHotelId() resolves the new hotel via the user's session
# automatically — no manual metadata edits needed.
CLERK_WEBHOOK_SECRET=""

# ── Optional: explicit hotel id override ──────────────────────────────────
# When set, currentHotelId() returns this regardless of Clerk session.
# Useful for prod single-tenant deploys or scripted CI.
# STAYBOARD_HOTEL_ID=""

# ── Webhook authentication (REQUIRED in production) ───────────────────────
# Shared secret for the Booking.com inbound webhook. Callers must send it as
# the `x-webhook-secret` header. Compared in constant time.
# Dev: may be left unset (check skipped). Production: REQUIRED — when unset the
# booking-ingestion endpoint refuses requests with 503, since an open endpoint
# would let anyone inject/modify/cancel bookings.
WEBHOOK_SECRET=""

# ── Auth bypass escape hatch (production only) ────────────────────────────
# When Clerk is not configured AND NODE_ENV=production, the app fails CLOSED
# (503 on authenticated pages) to avoid accidentally serving a public,
# unauthenticated deploy. Set ALLOW_NO_AUTH=1 to intentionally run without
# auth (e.g. a public demo). Has no effect in dev.
# ALLOW_NO_AUTH=""

# ── Optional: Stripe payments ─────────────────────────────────────────────
# 1. https://dashboard.stripe.com/test/apikeys → copy Secret key (sk_test_…)
# 2. Set up webhook at /api/webhooks/stripe and copy signing secret (whsec_…)
#    Local dev: `stripe listen --forward-to localhost:3017/api/webhooks/stripe`
# When STRIPE_SECRET_KEY is set, the Bookings detail panel exposes a
# "Pay with Stripe" button that creates a Checkout Session.
# Successful payment → webhook flips Booking.payment to paid + records event.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Public flag the client checks to render the Stripe button. Mirror of
# whether STRIPE_SECRET_KEY is set; kept separate because secret keys cannot
# leak into client bundles.
NEXT_PUBLIC_STRIPE_ENABLED=""

# ── Optional: Hostaway middleware ─────────────────────────────────────────
# When BOTH set, syncMiddleware() calls the real Hostaway API.
# Without keys, it returns 5 mock reservations so UI is exercisable end-to-end.
HOSTAWAY_API_KEY=""
HOSTAWAY_ACCOUNT_ID=""
# HOSTAWAY_BASE_URL="https://api.hostaway.com/v1"

# ── Optional: cron / automation auth ──────────────────────────────────────
# When set, /api/cron/run requires Authorization: Bearer <secret> (matches
# Vercel Cron) or x-cron-secret header. Schedule e.g. every 30 min:
#   Vercel: vercel.json → { "crons": [{ "path": "/api/cron/run", "schedule": "*/30 * * * *" }] }
#   Dev:    `curl http://localhost:3000/api/cron/run`
CRON_SECRET=""

# ── Optional: slow-query logging ──────────────────────────────────────────
# Queries slower than SLOW_QUERY_MS (default 500) are recorded for /admin/perf.
# SLOW_QUERY_LOG="off"        # disable capture entirely
# SLOW_QUERY_MS="1000"        # raise threshold in production
# Query params can contain guest PII and are REDACTED by default. Opt in to
# capturing real param values only in a controlled debug environment:
# SLOW_QUERY_LOG_PARAMS="on"
